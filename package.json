{
  "name": "universe-ascendant",
  "version": "0.1.0",
  "private": true,
  "description": "UNIVERSE ASCENDANT — SuperEssence Studio",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node tools/build-manifest.mjs && tsc --noEmit && vite build",
    "assets": "node tools/fetch-assets.mjs && node tools/build-manifest.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@gltf-transform/cli": "^4.5.1",
    "@types/three": "0.170.0",
    "playwright": "1.56.1",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
